+// OAEP MGF1 has different function numbers in OpenSSL 1.0.2 and 1.1.x.
+$err_oaep_mgf1 = OPENSSL_VERSION_NUMBER < 0x10100000 ? '040A1079' : '04099079';
 
 // PKEY
 echo "PKEY errors\n";
@@ -119,7 +121,7 @@
 expect_openssl_errors('openssl_private_encrypt', ['0408F090']);
 // private decrypt with failed padding check
