diff --git a/ext/date/tests/bug80963.phpt b/ext/date/tests/bug80963.phpt
--- a/ext/date/tests/bug80963.phpt
+++ b/ext/date/tests/bug80963.phpt
@@ -4,17 +4,18 @@
 date.timezone=UTC
 --FILE--
 <?php
-$tzids = [ 'Europe/London', 'America/New_York', 'Europe/Berlin' ];
+$tzids = [ 'Europe/London' => 243, 'America/New_York' => 237, 'Europe/Berlin' => 144 ];
 
-foreach ($tzids as $tzid)
+foreach ($tzids as $tzid => $minimumTransitions)
 {
 	$tz = new DateTimeZone($tzid);
 	$t  = $tz->getTransitions();
-	var_dump(sizeof($t), end($t));
+	// tzdata may add history; retain the original minimum and exact final transition.
+	var_dump(count($t) >= $minimumTransitions, end($t));
 }
 ?>
